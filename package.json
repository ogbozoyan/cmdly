{
  "name": "cmdly",
  "version": "4.6.0",
  "private": true,
  "description": "A productivity command bar for Chrome",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types --no-warnings scripts/build.mjs",
    "watch": "node --experimental-strip-types --no-warnings scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "icons": "./scripts/icons.sh",
    "check_package": "npm run check && ./scripts/package.sh",
    "package": "npm run check && ./scripts/package.sh",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "demo": "npm run build && node scripts/record-demo.mjs",
    "release": "./scripts/release.sh"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}

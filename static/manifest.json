{
  "manifest_version": 3,
  "name": "Cmdly — Command Bar",
  "short_name": "Cmdly",
  "version": "2.0.1",
  "description": "A productivity command bar for Chrome: search tabs, history and bookmarks, run commands, calculate and decode — on Cmd+T.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open Cmdly",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "bookmarks",
    "history",
    "search",
    "favicon",
    "scripting",
    "sessions",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui.css",
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "open-bar": {
      "description": "Open the command bar — assign ⌘T / Ctrl+T here"
    }
  }
}
